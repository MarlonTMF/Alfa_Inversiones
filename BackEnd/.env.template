# Copiar este archivo a .env y completar con credenciales propias.
# .env nunca debe commitearse (ver .gitignore).

# --- Base de datos (PostgreSQL local o remota) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=db_inmobiliaria
DB_SSL=false

# --- ImageKit (almacenamiento de imágenes) ---
# Obtener en: https://imagekit.io/dashboard/developer/api-keys
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/tu_id

# --- Cloudinary (almacenamiento de imágenes, alternativa) ---
# Obtener en: https://console.cloudinary.com/settings/api-keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
